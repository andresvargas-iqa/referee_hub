# Development environment configuration
# Base URL for the application
BASE_URL=/

# Bugsnag API key for error tracking
# Use empty string for development if not needed
BUGSNAG_API_KEY=

# Stripe publishable key for payments
# Use test key or empty string for development
STRIPE_PUBLISHABLE_KEY=pk_test_stub

# Node environment
NODE_ENV=development

# API configuration
REACT_APP_API_URL=http://localhost:5000
