# Frontend Environment Configuration
# This file contains environment variables for the React application.
# 
# For development:
# - Copy this file to .env and update values as needed
# - The build will load variables from .env via dotenv-webpack
#
# For CI/CD:
# - Pipeline automatically creates .env with these defaults
# - Override specific variables in GitHub Actions secrets if needed

# Base URL for the application (used for script loading in index.html)
BASE_URL=/

# Bugsnag API key for error tracking and monitoring
# Leave empty for development if not using Bugsnag
BUGSNAG_API_KEY=

# Stripe publishable key for payment processing
# Use test key (pk_test_*) for development
STRIPE_PUBLISHABLE_KEY=pk_test_stub

# Node environment
NODE_ENV=development

# API URL for backend communication
REACT_APP_API_URL=http://localhost:5000
